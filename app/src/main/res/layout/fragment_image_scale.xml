<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Image Scale"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pinch to zoom and drag to move the image."
        android:textSize="14sp"
        android:textColor="@color/text_muted" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="20dp"
        android:background="@color/purple_soft"
        android:clipChildren="true">

        <com.example.broadcastreceiver.ZoomableImageView
            android:id="@+id/zoomImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Zoomable internet image" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetZoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Reset Zoom"
        android:textAllCaps="false"
        app:cornerRadius="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Use two fingers to zoom in or out."
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/text_muted" />

</LinearLayout>
